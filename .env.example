# Copy this file to .env and fill in your own values. NEVER commit .env.
#
# These values are read ONLY by the server in server/. They do not start with
# VITE_, so Vite never puts them in the browser bundle.

# SQLite: each team member has their own local database file. The path is relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Port for the Express API server. Vite forwards /api requests here.
PORT=3001

# Adzuna job search (Find Jobs): free keys at https://developer.adzuna.com/signup
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
# Country for job listings (us, gb, ca, ...)
ADZUNA_COUNTRY=us

# O*NET Web Services (Explore Careers): free key at https://services.onetcenter.org/developer/signup
ONET_API_KEY=your-onet-api-key

# Feature switches. These are NOT secrets: any VITE_ value ends up in the browser.
# The AI assistant is paused, so keep this false.
VITE_ENABLE_AI_ASSISTANT=false
